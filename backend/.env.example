PORT=3001
JWT_SECRET=<openssl rand -hex 64>
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=visitormgmt_abatplus
DB_USER=visitormgmt_abatplus
DB_PASSWORD=<beim CREATE USER vergebenes Passwort>
APP_URL=https://deine-domain.de

# Microsoft SSO — eine einzige Azure-App-Registrierung für Login UND Verzeichnis-Zugriff
# (Gastgeber-Autocomplete, AD-Gegencheck, Ankunfts-Mails). Diese Werte sind nur ein
# Fallback: einfacher (kein Neustart nötig) über Einstellungen → Microsoft SSO im
# laufenden Betrieb konfigurierbar.
# Delegierte Berechtigungen: openid, profile, email, User.Read
# Anwendungsberechtigungen (Admin-Zustimmung erforderlich): User.Read.All, Mail.Send
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Absender-Postfach für Gastgeber-Benachrichtigungen (Microsoft Graph sendMail)
NOTIFY_FROM_EMAIL=

# Initialer Admin-Account (nur beim allerersten Start wirksam, danach ignoriert)
# ADMIN_EMAIL=admin@firma.de
# ADMIN_PASSWORD=SicheresPasswort123!
